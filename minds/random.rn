/*
INPUT
pub struct Cell {
    pub id: CellId,
    pub team_id: TeamId,
    pub energy: u32, 
    pub min_energy: u32, // Cost to exist, dropped on death
    pub marker: u32,
    pub loaded: bool,
    pub age: u32,
    pub memory: [u8; 2048],
    pub message_queue: Vec<CellMessage>,
    pub defending: bool,
    // Add other cell properties like senses, memory, etc.
}

pub struct CellContext {
    pub elevation: [i32; 9],
    pub energy: [u32; 9],
    pub pheromone: [Option<Pheromone>; 9],
    pub markers: [Option<u32>; 8],
}

OUTPUT

pub enum CellAction {
    SendMessage(Direction, CellMessage),
    Defend,
    Attack(Direction),
    LiftTerrain,
    DumpTerrain,
    SetPheromone(Pheromone),
    Move(Direction),
    Split(Direction, i32, u32, [u8; 2048]),
    DoNothing,
}
pub enum Direction {
    North,
    South,
    East,
    West,
    NorthEast,
    NorthWest,
    SouthEast,
    SouthWest,
    // Center is a valid direction but usually not for targeted actions
}

pub type Pheromone = u32;

pub struct CellMessage {
    data, // Expected to be [u8; 512]
}
*/

// The `cell` and `context` parameters are passed by the game.
// `cell` provides info like `cell.id`, `cell.energy`, `cell.min_energy`, etc.
// `context` provides info about the cell's surroundings.

pub fn mind(cell, context) {
    // There are 9 possible actions in CellAction enum
    let action_index = rand::u64() % 9;

    // Array of 8 directions (excluding Center) for actions that need a target direction
    let directions = [
        Direction::North, Direction::South, Direction::East, Direction::West,
        Direction::NorthEast, Direction::NorthWest, Direction::SouthEast, Direction::SouthWest,
    ];
    let random_direction_idx = rand::u64() % 8;
    let chosen_direction = directions[random_direction_idx];

    match action_index {
        0 => { // SendMessage
            let message_data_array = [0u8; 512]; // Array of 512 u8 zeros
            let message = CellMessage { data: message_data_array };
            CellAction::SendMessage(chosen_direction, message)
        },
        1 => CellAction::Defend,
        2 => CellAction::Attack(chosen_direction),
        3 => CellAction::LiftTerrain,
        4 => CellAction::DumpTerrain,
        5 => { // SetPheromone
            let pheromone_value = rand::u64() as u32; // Generate a random u32 value
            CellAction::SetPheromone(pheromone_value)
        },
        6 => CellAction::Move(chosen_direction),
        7 => { // Split
            // Provide a small amount of energy above the minimum required for the child.
            // The game logic handles subtracting this from the parent.
            // `cell.min_energy` is u32 in Rust, becomes i64 in Rune.
            // Split action expects energy as i64.
            let energy_for_child = cell.min_energy + 5; 
            let marker = rand::u64() as u32; // Random u32 marker
            let memory_array = [0u8; 2048];    // Zeroed memory for the new cell
            CellAction::Split(chosen_direction, energy_for_child, marker, memory_array)
        },
        8 => CellAction::DoNothing,
        // Default case, though % 9 should cover all.
        _ => CellAction::DoNothing, 
    }
}